# Copie este arquivo como .env.development ou .env.production
# e preencha com as credenciais do projeto Supabase correspondente.
#
# Encontre os valores em:
#   supabase.com/dashboard → seu projeto → Settings → API

VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_ANON_KEY="<anon-public-key>"
