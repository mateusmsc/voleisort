import { describe, it, expect } from 'vitest'
import {
  insertPlayerIntoQueue,
  applySubstitutions,
  getRemovedFromMatch,
  getNewcomers,
  applyCheckinWithActiveMatch,
  fillGapsFromNextQueues,
} from './checkin-logic.js'

describe('insertPlayerIntoQueue', () => {
  it('cria uma nova fila com um time quando a fila está vazia', () => {
    const result = insertPlayerIntoQueue([], 'p1', 6)
    expect(result).toEqual([['p1']])
  })

  it('encaixa no último time se ele estiver incompleto', () => {
    const queue = [['a', 'b', 'c'], ['d', 'e']]
    const result = insertPlayerIntoQueue(queue, 'f', 3)

    expect(result).toEqual([['a', 'b', 'c'], ['d', 'e', 'f']])
  })

  it('cria um novo time se o último já estiver completo', () => {
    const queue = [['a', 'b', 'c'], ['d', 'e', 'f']]
    const result = insertPlayerIntoQueue(queue, 'g', 3)

    expect(result).toEqual([['a', 'b', 'c'], ['d', 'e', 'f'], ['g']])
  })

  it('não muta a fila original', () => {
    const queue = [['a', 'b']]
    insertPlayerIntoQueue(queue, 'c', 3)
    expect(queue).toEqual([['a', 'b']])
  })

  it('funciona com teamSize=6 e único time incompleto', () => {
    const queue = [['a', 'b', 'c', 'd', 'e']]
    const result = insertPlayerIntoQueue(queue, 'f', 6)
    expect(result[0].length).toBe(6)
    expect(result.length).toBe(1)
  })

  it('teamSize=6 com último time exatamente cheio cria novo time', () => {
    const queue = [['a', 'b', 'c', 'd', 'e', 'f']]
    const result = insertPlayerIntoQueue(queue, 'g', 6)
    expect(result.length).toBe(2)
    expect(result[1]).toEqual(['g'])
  })
})

describe('getRemovedFromMatch', () => {
  it('retorna IDs que estavam na partida mas saíram do check-in', () => {
    const inMatch = ['p1', 'p2', 'p3', 'p4']
    const checkedIn = new Set(['p1', 'p3'])
    expect(getRemovedFromMatch(inMatch, checkedIn)).toEqual(['p2', 'p4'])
  })

  it('retorna array vazio se nenhum jogador saiu', () => {
    const inMatch = ['p1', 'p2']
    const checkedIn = new Set(['p1', 'p2', 'p3'])
    expect(getRemovedFromMatch(inMatch, checkedIn)).toEqual([])
  })

  it('retorna todos se o check-in ficou completamente vazio', () => {
    const inMatch = ['p1', 'p2', 'p3']
    const checkedIn = new Set()
    expect(getRemovedFromMatch(inMatch, checkedIn)).toEqual(['p1', 'p2', 'p3'])
  })
})

describe('getNewcomers', () => {
  it('retorna jogadores presentes que não estavam na partida', () => {
    const present = [
      { id: 'p1', rating: 80 },
      { id: 'p2', rating: 70 },
      { id: 'p3', rating: 60 },
    ]
    const inMatch = ['p1']
    const result = getNewcomers(present, inMatch)
    expect(result.map(p => p.id)).toEqual(['p2', 'p3'])
  })

  it('retorna array vazio se todos já estavam na partida', () => {
    const present = [{ id: 'p1' }, { id: 'p2' }]
    const inMatch = ['p1', 'p2']
    expect(getNewcomers(present, inMatch)).toHaveLength(0)
  })

  it('retorna todos se nenhum estava na partida (primeira entrada)', () => {
    const present = [{ id: 'p1' }, { id: 'p2' }, { id: 'p3' }]
    expect(getNewcomers(present, [])).toHaveLength(3)
  })
})

describe('applySubstitutions', () => {
  function makeGetPlayer(players) {
    const map = Object.fromEntries(players.map(p => [p.id, p]))
    return id => map[id]
  }

  it('substitui um jogador removido do teamA pelo newcomer de rating mais próximo', () => {
    const teamA    = ['p1', 'p2']
    const teamB    = ['p3', 'p4']
    const newcomers = [
      { id: 'n1', rating: 85 },
      { id: 'n2', rating: 30 },
    ]
    const allPlayers = [
      { id: 'p1', rating: 90 },
      { id: 'p2', rating: 70 },
      { id: 'p3', rating: 60 },
      { id: 'p4', rating: 50 },
      ...newcomers,
    ]
    const getPlayer = makeGetPlayer(allPlayers)

    const { newTeamA } = applySubstitutions({
      teamA, teamB, nextTeams: [],
      removedFromMatch: ['p1'],
      newcomers,
      getPlayer,
    })

    expect(newTeamA).toContain('n1')
    expect(newTeamA).not.toContain('p1')
  })

  it('substitui um jogador removido do teamB', () => {
    const teamA    = ['p1', 'p2']
    const teamB    = ['p3', 'p4']
    const newcomers = [{ id: 'n1', rating: 55 }]
    const allPlayers = [
      { id: 'p3', rating: 60 },
      { id: 'p4', rating: 50 },
      { id: 'n1', rating: 55 },
    ]
    const getPlayer = makeGetPlayer(allPlayers)

    const { newTeamB } = applySubstitutions({
      teamA, teamB, nextTeams: [],
      removedFromMatch: ['p3'],
      newcomers,
      getPlayer,
    })

    expect(newTeamB).toContain('n1')
    expect(newTeamB).not.toContain('p3')
  })

  it('substitui um jogador removido de nextTeams', () => {
    const teamA    = ['p1', 'p2']
    const teamB    = ['p3', 'p4']
    const nextTeams = [['q1', 'q2']]
    const newcomers = [{ id: 'n1', rating: 70 }]
    const allPlayers = [
      { id: 'q1', rating: 75 },
      { id: 'q2', rating: 65 },
      { id: 'n1', rating: 70 },
    ]
    const getPlayer = makeGetPlayer(allPlayers)

    const { newNextTeams } = applySubstitutions({
      teamA, teamB, nextTeams,
      removedFromMatch: ['q1'],
      newcomers,
      getPlayer,
    })

    expect(newNextTeams[0]).toContain('n1')
    expect(newNextTeams[0]).not.toContain('q1')
  })

  it('quando não há newcomer disponível, remove o jogador sem substituto', () => {
    const teamA = ['p1', 'p2']
    const teamB = ['p3', 'p4']
    const getPlayer = makeGetPlayer([
      { id: 'p1', rating: 90 },
    ])

    const { newTeamA } = applySubstitutions({
      teamA, teamB, nextTeams: [],
      removedFromMatch: ['p1'],
      newcomers: [],
      getPlayer,
    })

    expect(newTeamA).not.toContain('p1')
    expect(newTeamA.length).toBe(1)
  })

  it('cada newcomer é usado no máximo uma vez para múltiplas substituições', () => {
    const teamA    = ['p1', 'p2']
    const teamB    = ['p3', 'p4']
    const newcomers = [
      { id: 'n1', rating: 80 },
      { id: 'n2', rating: 60 },
    ]
    const allPlayers = [
      { id: 'p1', rating: 90 },
      { id: 'p2', rating: 85 },
      { id: 'p3', rating: 55 },
      { id: 'p4', rating: 50 },
      ...newcomers,
    ]
    const getPlayer = makeGetPlayer(allPlayers)

    const { newTeamA, newTeamB } = applySubstitutions({
      teamA, teamB, nextTeams: [],
      removedFromMatch: ['p1', 'p3'],
      newcomers,
      getPlayer,
    })

    const allIds = [...newTeamA, ...newTeamB]
    const unique = new Set(allIds)
    expect(unique.size).toBe(allIds.length)
  })

  it('não muta os arrays de entrada (teamA, teamB, nextTeams)', () => {
    const teamA    = ['p1', 'p2']
    const teamB    = ['p3', 'p4']
    const nextTeams = [['q1']]
    const newcomers = [{ id: 'n1', rating: 70 }]
    const allPlayers = [
      { id: 'p1', rating: 90 },
      { id: 'n1', rating: 70 },
    ]
    const getPlayer = makeGetPlayer(allPlayers)

    applySubstitutions({
      teamA, teamB, nextTeams,
      removedFromMatch: ['p1'],
      newcomers,
      getPlayer,
    })

    expect(teamA).toEqual(['p1', 'p2'])
    expect(teamB).toEqual(['p3', 'p4'])
    expect(nextTeams).toEqual([['q1']])
  })

  it('jogador com rating desconhecido assume rating 50 para cálculo de distância', () => {
    const teamA    = ['unknown']
    const teamB    = ['p2']
    const newcomers = [
      { id: 'n_close', rating: 52 },
      { id: 'n_far',   rating: 90 },
    ]
    const getPlayer = id => id === 'p2' ? { id: 'p2', rating: 60 } : undefined

    const { newTeamA } = applySubstitutions({
      teamA, teamB, nextTeams: [],
      removedFromMatch: ['unknown'],
      newcomers,
      getPlayer,
    })

    expect(newTeamA).toContain('n_close')
    expect(newTeamA).not.toContain('n_far')
  })
})

describe('applyCheckinWithActiveMatch', () => {
  function makeGetPlayer(players) {
    const map = Object.fromEntries(players.map(p => [p.id, p]))
    return id => map[id]
  }

  it('[RED] jogador existente que entra no check-in com partida ativa entra na fila', () => {
    const teamA = ['a1', 'a2']
    const teamB = ['b1', 'b2']
    const nextTeams = [['q1', 'q2']]
    const teamSize = 2
    const allPlayers = [
      { id: 'a1', rating: 80 }, { id: 'a2', rating: 70 },
      { id: 'b1', rating: 60 }, { id: 'b2', rating: 50 },
      { id: 'q1', rating: 45 }, { id: 'q2', rating: 40 },
      { id: 'newcomer', rating: 55 },
    ]
    const getPlayer = makeGetPlayer(allPlayers)
    const checkedInSet = new Set(['a1', 'a2', 'b1', 'b2', 'q1', 'q2', 'newcomer'])
    const currentInMatch = [...teamA, ...teamB, ...nextTeams.flat()]

    const result = applyCheckinWithActiveMatch({
      teamA, teamB, nextTeams,
      checkedInSet,
      presentPlayers: allPlayers.filter(p => checkedInSet.has(p.id)),
      currentInMatch,
      teamSize,
      getPlayer,
    })

    const allInQueue = result.newNextTeams.flat()
    expect(allInQueue).toContain('newcomer')
  })

  it('[RED] jogador removido do check-in sai da partida, substituto entra pelo crit�rio de tempo de fora', () => {
    const teamA = ['a1', 'a2']
    const teamB = ['b1', 'b2']
    const nextTeams = [['q1', 'q2']]
    const teamSize = 2
    const allPlayers = [
      { id: 'a1', rating: 80 }, { id: 'a2', rating: 70 },
      { id: 'b1', rating: 60 }, { id: 'b2', rating: 50 },
      { id: 'q1', rating: 45 }, { id: 'q2', rating: 40 },
      { id: 'bench', rating: 55 },
    ]
    const getPlayer = makeGetPlayer(allPlayers)
    const checkedInSet = new Set(['a2', 'b1', 'b2', 'q1', 'q2', 'bench'])
    const currentInMatch = [...teamA, ...teamB, ...nextTeams.flat()]

    const result = applyCheckinWithActiveMatch({
      teamA, teamB, nextTeams,
      checkedInSet,
      presentPlayers: allPlayers.filter(p => checkedInSet.has(p.id)),
      currentInMatch,
      teamSize,
      getPlayer,
    })

    expect(result.newTeamA).not.toContain('a1')
    const allResultIds = [...result.newTeamA, ...result.newTeamB, ...result.newNextTeams.flat()]
    expect(allResultIds).toContain('bench')
  })
})

describe('fillGapsFromNextQueues', () => {
  it('[RED] remove um jogador da 1� pr�xima e promove da 2� priorizando tempo de fora', () => {
    const nextTeams = [
      ['n1', 'n2'],
      ['n3', 'n4'],
    ]
    const roundsOut = { n1: 0, n2: 0, n3: 3, n4: 1 }
    const teamSize = 2

    const result = fillGapsFromNextQueues({
      nextTeams,
      removedIds: ['n1'],
      roundsOut,
      teamSize,
    })

    expect(result[0]).not.toContain('n1')
    expect(result[0]).toContain('n3')
  })

  it('[RED] quando h� empate no tempo de fora, respeita a ordem FIFO (quem estava antes na fila sobe)', () => {
    const nextTeams = [
      ['n1', 'n2'],
      ['n3', 'n4'],
    ]
    const roundsOut = { n1: 0, n2: 0, n3: 1, n4: 1 }
    const teamSize = 2

    const result = fillGapsFromNextQueues({
      nextTeams,
      removedIds: ['n1'],
      roundsOut,
      teamSize,
    })

    expect(result[0]).not.toContain('n1')
    expect(result[0]).toContain('n3')
  })

  it('[RED] nao duplica jogadores apos promo��o', () => {
    const nextTeams = [
      ['n1', 'n2'],
      ['n3', 'n4'],
    ]
    const roundsOut = {}
    const teamSize = 2

    const result = fillGapsFromNextQueues({
      nextTeams,
      removedIds: ['n1'],
      roundsOut,
      teamSize,
    })

    const allIds = result.flat()
    const unique = new Set(allIds)
    expect(unique.size).toBe(allIds.length)
  })
})
